# ----------------------------------------------------------------------
# Apache / LiteSpeed Server Configuration for Gnarly MTB Nepal
# ----------------------------------------------------------------------

# 1. Set Default Directory Index Priority
DirectoryIndex index.html index.php

# 2. Rewrite Engine & Routing Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS redirection
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (gnarlymtb.com)
  RewriteCond %{HTTP_HOST} ^www\.gnarlymtb\.com$ [NC]
  RewriteRule ^(.*)$ https://gnarlymtb.com/$1 [L,R=301]

  # Remove trailing slashes from URLs (unless it is an existing directory)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/(.*)/$
  RewriteRule ^/(.*)/$ /$1 [L,R=301]

  # Clean URLs: Map extension-less URLs to .html (e.g., /gallery -> /gallery.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# 3. Security Headers (matching vercel.json)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Browser Caching & Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages: Do NOT cache long term; always revalidate so content changes show instantly
  ExpiresByType text/html "access plus 0 seconds"

  # Images & Media
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # CSS, JavaScript (use ?v=... cache busting when updated)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Webmanifest & Fonts
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Ensure browsers revalidate HTML immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 6. Disable Directory Browsing
Options -Indexes

# 7. Custom 404 Fallback
ErrorDocument 404 /index.html
